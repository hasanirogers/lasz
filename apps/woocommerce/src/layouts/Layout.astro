---
import { html } from 'lit';
import { unsafeHTML } from 'lit/directives/unsafe-html.js';
import { renderLit } from '../shared/utilities';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';

import 'kemet-ui/styles/kemet.base.css';
import '@wordpress/block-library/build-style/style.css';
import '@wordpress/block-library/build-style/theme.css';

import '../styles/base.css';
import '../styles/cea.css';
import '../styles/wordpress.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'LaszCommerce' } = Astro.props;

const HeaderContainer = await AstroContainer.create();
const HeaderHTML = await HeaderContainer.renderToString(Header);
const SlotHTML = await Astro.slots.render('default');
const FooterContainer = await AstroContainer.create();
const FooterHTML = await FooterContainer.renderToString(Footer);

const isLoggedIn = !!Astro.cookies.get('lasz-user');
const accountLink = isLoggedIn ? '<a href="/account">Account</a>' : '';
const loginLink = !isLoggedIn ? '<a href="/login">Login</a>' : '';
const logoutLink = isLoggedIn ? '<a href="/logout">Logout</a>' : '';

// Reduce Layout Shift by supporting Declarative Shadow DOM conversion of kemet-drawer
const kemetDrawerElement = renderLit(html`
  <kemet-drawer overlay side="right">
    <aside slot="navigation" hidden>
      <a href="/"><img src="/logo.webp" alt="LaszCommerce" width="300" height="300" /></a>
      <h2>${title}</h2>
      <nav>
        <a href="/">Home</a>
        <a href="/cart">Cart</a>
        <a href="/checkout">Checkout</a>
        <a href="/order/status">Order Status</a>
        ${unsafeHTML(accountLink)}
        ${unsafeHTML(loginLink)}
        ${unsafeHTML(logoutLink)}
      </nav>
    </aside>
    <main slot="content">
      ${unsafeHTML(HeaderHTML)}
      ${unsafeHTML(SlotHTML)}
      ${unsafeHTML(FooterHTML)}
    </main>
  </kemet-drawer>
`);
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content="The world's first LASZ app" />
		<link rel="preload" as="image" href="/logo.webp" fetchpriority="high" />
		<title>{title}</title>
	</head>
	<body>
    <Fragment set:html={kemetDrawerElement} />
    <kemet-alert overlay="top-full" closable>
      <kemet-icon-bootstrap slot="icon" icon="info-circle" size="24"></kemet-icon-bootstrap>
    </kemet-alert>
	</body>
</html>

<script>
  import 'kemet-ui/elements/drawer';
  import 'kemet-ui/elements/card';
  import 'kemet-ui/elements/button';
  import 'kemet-ui/elements/badge';
  import 'kemet-ui/elements/fab';
  import 'kemet-ui/elements/alert';
  import 'kemet-ui/elements/icon-bootstrap';
  import 'kemet-ui/elements/field';
  import 'kemet-ui/elements/input';
  import 'kemet-ui/elements/textarea';
  import 'kemet-ui/elements/popper';
  import 'kemet-ui/elements/carousel';
  import 'kemet-ui/elements/carousel-slide';
  import 'kemet-ui/elements/carousel-prev';
  import 'kemet-ui/elements/carousel-next';
  import 'kemet-ui/elements/select';
  import 'kemet-ui/elements/option';
  import 'kemet-ui/elements/checkbox';
  import 'kemet-ui/elements/password';

  // app custom elements
  import '../elements/lasz-header';
  import '../elements/lasz-nav-top';
  import '../elements/lasz-product';
  import '../elements/lasz-newsletter-form';


  // handle alert
  import alertStore from '../stores/alert';
  import type HTMLKemetAlertElement from 'kemet-ui/elements/alert.d.ts';
  import type HTMLKemetIconBootstrapElement from 'kemet-ui/elements/icon-bootstrap.d.ts';

  const alert = document.querySelector('kemet-alert') as HTMLKemetAlertElement;
  const alertIcon = alert.querySelector('kemet-alert kemet-icon-bootstrap') as HTMLKemetIconBootstrapElement;

  alertStore.subscribe((state) => {
    if (state.config) {
      alert.innerHTML = '';
      const message = document.createElement('div');
      message.innerHTML = state.config.message as string;
      alert.opened = state.config.opened;
      alert.status = state.config.status as "standard" | "primary" | "success" | "warning" | "error";
      alertIcon.icon = state.config.icon as string;
      alert.appendChild(message);
      alert.appendChild(alertIcon);
    }
  });

  // handle hamburger
  import appStore from '../stores/app';
  import type HTMLKemetDrawerElement from 'kemet-ui/elements/drawer.d.ts';

  const drawer = document.querySelector('kemet-drawer') as HTMLKemetDrawerElement;
  const aside = drawer.querySelector('aside');

  setTimeout(() => {
    aside?.removeAttribute('hidden');
  }, 1000);

  appStore.subscribe((state) => {
    if (state.drawerOpened) {
      drawer.opened = state.drawerOpened;
    }
  });

  drawer.addEventListener('kemet-closed', () => {
    appStore.setState({ drawerOpened: false });
  });

  drawer.addEventListener('kemet-opened', () => {
    appStore.setState({ drawerOpened: true });
  });

  // remove hidden from nav-top on DOMContentLoaded
  document.addEventListener('DOMContentLoaded', () => {
    const navTop = document.querySelector('lasz-nav-top');
    if (navTop) {
      navTop.removeAttribute('hidden');
    }
  });
</script>
<style>
  aside {
    display: flex;
    gap: 0.5rem;
    flex-direction: column;
    min-height: 100vh;
    padding: 1rem 2rem 1rem 1rem;
    width: 100%;
    box-sizing: border-box;
  }

  nav {
    color: var(--color-link);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
